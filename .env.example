# Source of truth for every variable in this repo.
# Next.js loads dotenv files from web/, and the Sanity CLI loads them from studio/,
# so a root .env.local is read by neither. `npm run init` splits this file into
# web/.env.local (the NEXT_PUBLIC_* keys plus the server secrets) and
# studio/.env (the SANITY_STUDIO_* keys).

# --- web/.env.local ---

# Sanity project id, visible in the browser and shared by the site and the studio
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset the site reads from
NEXT_PUBLIC_SANITY_DATASET=production

# Absolute origin of the deployed site, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity Viewer token, server only, powers draft mode and authenticated queries
SANITY_API_READ_TOKEN=

# Shared secret the Sanity webhooks send so revalidate routes can verify the caller
SANITY_REVALIDATE_SECRET=

# --- studio/.env ---

# Sanity project id for the studio workspace, normally the same value as the public one
SANITY_STUDIO_PROJECT_ID=

# Sanity dataset for the studio workspace
SANITY_STUDIO_DATASET=production

# Origin the studio opens for Presentation live preview
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional, Google Analytics measurement id
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional, PostHog project api key
NEXT_PUBLIC_POSTHOG_KEY=

# Optional, PostHog api host
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
